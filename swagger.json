{
  "openapi": "3.0.3",
  "info": {
    "title": "GameVault API",
    "version": "1.0.0",
    "description": "API du catalogue de jeux vidéo GameVault. Les erreurs sont toujours au format { \"erreur\": \"...\" } (et \"details\" pour les erreurs de validation)."
  },
  "servers": [{ "url": "/api/v1" }],
  "tags": [{ "name": "Auth" }, { "name": "Jeux" }, { "name": "Avis" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "example": "6751a2b3c4d5e6f708192a3b" }
    },
    "schemas": {
      "Erreur": {
        "type": "object",
        "properties": {
          "erreur": { "type": "string", "example": "Données invalides" },
          "details": { "type": "array", "items": { "type": "string" }, "example": ["La note va de 0 à 20"] }
        }
      },
      "JeuInput": {
        "type": "object",
        "required": ["titre", "editeur", "annee", "plateformes", "genres", "pegi", "note", "prix"],
        "properties": {
          "titre": { "type": "string", "example": "The Legend of Zelda: Tears of the Kingdom" },
          "editeur": { "type": "string", "example": "Nintendo" },
          "annee": { "type": "integer", "minimum": 1970, "example": 2023 },
          "plateformes": { "type": "array", "items": { "type": "string", "enum": ["PC", "PS5", "PS4", "Xbox Series", "Switch", "Mobile"] }, "example": ["Switch"] },
          "genres": { "type": "array", "items": { "type": "string", "enum": ["action", "aventure", "rpg", "fps", "sport", "course", "strategie", "simulation", "plateforme", "combat", "horreur", "puzzle"] }, "example": ["action", "aventure"] },
          "pegi": { "type": "integer", "enum": [3, 7, 12, 16, 18], "example": 12 },
          "note": { "type": "number", "minimum": 0, "maximum": 20, "example": 19 },
          "multijoueur": { "type": "boolean", "default": false },
          "prix": { "type": "number", "minimum": 0, "example": 69.99 }
        }
      },
      "Jeu": {
        "allOf": [
          { "$ref": "#/components/schemas/JeuInput" },
          { "type": "object", "properties": { "_id": { "type": "string" }, "jaquette": { "type": "string", "nullable": true }, "createdAt": { "type": "string" }, "updatedAt": { "type": "string" } } }
        ]
      },
      "Avis": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "jeu": { "type": "string" },
          "auteur": { "type": "object", "properties": { "_id": { "type": "string" }, "pseudo": { "type": "string", "example": "Ada" } } },
          "note": { "type": "number", "example": 17 },
          "commentaire": { "type": "string", "example": "Un monde immense, on s’y perd avec plaisir." },
          "createdAt": { "type": "string" }
        }
      }
    },
    "responses": {
      "400": { "description": "Données ou identifiant invalides", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } } } },
      "401": { "description": "Connexion requise", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } } } },
      "403": { "description": "Accès refusé", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } } } },
      "404": { "description": "Introuvable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } } } },
      "409": { "description": "Conflit (doublon)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } } } }
    }
  },
  "paths": {
    "/auth/inscription": {
      "post": {
        "tags": ["Auth"], "summary": "Créer un compte (rôle toujours « user »)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password", "pseudo"], "properties": { "email": { "type": "string", "example": "ada@mail.fr" }, "password": { "type": "string", "minLength": 8, "example": "motdepasse" }, "pseudo": { "type": "string", "example": "Ada" } } } } } },
        "responses": { "201": { "description": "Compte créé" }, "400": { "$ref": "#/components/responses/400" }, "409": { "$ref": "#/components/responses/409" } }
      }
    },
    "/auth/connexion": {
      "post": {
        "tags": ["Auth"], "summary": "Se connecter : renvoie un token (id + rôle)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string", "example": "admin@gamevault.fr" }, "password": { "type": "string", "example": "Admin1234" } } } } } },
        "responses": { "200": { "description": "{ token, refreshToken, user }" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "429": { "description": "Trop de tentatives" } }
      }
    },
    "/auth/moi": {
      "get": {
        "tags": ["Auth"], "summary": "Mon compte (sans le mot de passe)", "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Le compte connecté" }, "401": { "$ref": "#/components/responses/401" } }
      }
    },
    "/auth/rafraichir": {
      "post": {
        "tags": ["Auth"], "summary": "Nouveau token à partir du refresh token (bonus)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } } } } },
        "responses": { "200": { "description": "{ token, refreshToken }" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" } }
      }
    },
    "/auth/deconnexion": {
      "post": {
        "tags": ["Auth"], "summary": "Déconnexion : invalide le refresh token (bonus)", "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Déconnecté" }, "401": { "$ref": "#/components/responses/401" } }
      }
    },
    "/jeux": {
      "get": {
        "tags": ["Jeux"], "summary": "Liste paginée avec recherche, filtres et tri",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limite", "in": "query", "schema": { "type": "integer", "default": 10, "maximum": 50 } },
          { "name": "recherche", "in": "query", "schema": { "type": "string" }, "example": "zelda" },
          { "name": "plateforme", "in": "query", "schema": { "type": "string" }, "example": "Switch" },
          { "name": "genre", "in": "query", "schema": { "type": "string" }, "example": "rpg" },
          { "name": "pegiMax", "in": "query", "schema": { "type": "integer" } },
          { "name": "noteMin", "in": "query", "schema": { "type": "number" } },
          { "name": "tri", "in": "query", "schema": { "type": "string", "enum": ["note", "annee", "titre", "prix"], "default": "note" } },
          { "name": "ordre", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] }, "description": "Par défaut : desc pour la note, asc pour le reste" }
        ],
        "responses": { "200": { "description": "{ donnees: [Jeu], pagination: { page, limite, total, pages } }" } }
      },
      "post": {
        "tags": ["Jeux"], "summary": "Ajouter un jeu (admin)", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JeuInput" } } } },
        "responses": { "201": { "description": "Jeu créé", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Jeu" } } } }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "403": { "$ref": "#/components/responses/403" }, "409": { "$ref": "#/components/responses/409" } }
      }
    },
    "/jeux/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Jeux"], "summary": "Un jeu",
        "responses": { "200": { "description": "Le jeu", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Jeu" } } } }, "400": { "$ref": "#/components/responses/400" }, "404": { "$ref": "#/components/responses/404" } }
      },
      "put": {
        "tags": ["Jeux"], "summary": "Modifier un jeu (admin, au moins un champ)", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JeuInput" } } } },
        "responses": { "200": { "description": "Jeu modifié" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "403": { "$ref": "#/components/responses/403" }, "404": { "$ref": "#/components/responses/404" }, "409": { "$ref": "#/components/responses/409" } }
      },
      "delete": {
        "tags": ["Jeux"], "summary": "Supprimer un jeu et tous ses avis (admin)", "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Supprimé" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "403": { "$ref": "#/components/responses/403" }, "404": { "$ref": "#/components/responses/404" } }
      }
    },
    "/jeux/{id}/avis": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "get": {
        "tags": ["Avis"], "summary": "Les avis d'un jeu, avec le pseudo des auteurs",
        "responses": { "200": { "description": "Liste des avis", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Avis" } } } } }, "400": { "$ref": "#/components/responses/400" }, "404": { "$ref": "#/components/responses/404" } }
      },
      "post": {
        "tags": ["Avis"], "summary": "Donner un avis (une fois par jeu, l'auteur vient du token)", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["note"], "properties": { "note": { "type": "number", "minimum": 0, "maximum": 20, "example": 17 }, "commentaire": { "type": "string", "maxLength": 500 } } } } } },
        "responses": { "201": { "description": "Avis créé" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "404": { "$ref": "#/components/responses/404" }, "409": { "$ref": "#/components/responses/409" } }
      }
    },
    "/jeux/{id}/jaquette": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "post": {
        "tags": ["Jeux"], "summary": "Envoyer la jaquette (admin, JPEG/PNG/WebP, 2 Mo max) - bonus", "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "jaquette": { "type": "string", "format": "binary" } } } } } },
        "responses": { "200": { "description": "Jeu avec le chemin de la jaquette" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "403": { "$ref": "#/components/responses/403" }, "404": { "$ref": "#/components/responses/404" } }
      }
    },
    "/avis/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/id" }],
      "delete": {
        "tags": ["Avis"], "summary": "Supprimer un avis (son auteur ou un admin)", "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Supprimé" }, "400": { "$ref": "#/components/responses/400" }, "401": { "$ref": "#/components/responses/401" }, "403": { "$ref": "#/components/responses/403" }, "404": { "$ref": "#/components/responses/404" } }
      }
    }
  }
}
